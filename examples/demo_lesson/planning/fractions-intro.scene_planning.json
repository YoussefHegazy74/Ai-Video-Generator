          "section_title": "What Is a Fraction?",
          "anchor": null
        },
        "text": "A fraction represents a part of a whole. The top number is the numerator. The bottom number is the denominator and shows how many equal parts the whole is divided into.",
        "kind": "text",
        "caption": null
      }
    ]
  },
  "script": {
    "scene_id": "fractions-intro",
    "language": "en",
    "segments": [
      {
        "segment_id": "seg-1",
        "text": "Think of a pizza cut into equal slices. A fraction shows how many slices you have, out of the whole pizza.",
        "estimated_duration_seconds": 6.0,
        "key_point_ids": [
          "kp-1"
        ]
      },
      {
        "segment_id": "seg-2",
        "text": "The top number is the numerator. The bottom number is the denominator, which counts the equal parts in the whole.",
        "estimated_duration_seconds": 7.0,
        "key_point_ids": [
          "kp-2"
        ]
      }
    ],
    "key_points": [
      {
