# Environment template. Copy to .env for local use; never commit a real .env.
# All AIVG_* values override config/settings.yaml and config/video_generation.yaml.

# Runtime and logging
AIVG_ENVIRONMENT=development
AIVG_LOG_LEVEL=INFO
AIVG_JSON_LOGS=true

# Storage (relative paths resolve against the repository root)
AIVG_STORAGE_ROOT=artifacts
# AIVG_STORAGE_TEMP_ROOT=artifacts/.work
# AIVG_STORAGE_REGISTRY_PATH=artifacts/artifact_registry.json

# Media tools
AIVG_MEDIA_FFMPEG_PATH=ffmpeg
AIVG_MEDIA_FFPROBE_PATH=ffprobe

# Provider: deterministic_whiteboard (default, local) or gemini_omni (optional AI)
AIVG_PROVIDER=deterministic_whiteboard
# AIVG_GEMINI_MODEL=gemini-omni-1.1-flash
# AIVG_GEMINI_ASPECT_RATIO=16:9
# AIVG_GEMINI_RESOLUTION=720p

# Local deterministic renderer / narration
# AIVG_WHITEBOARD_WIDTH=1280
# AIVG_WHITEBOARD_HEIGHT=720
# AIVG_WHITEBOARD_FPS=24
# AIVG_TTS_NARRATOR=auto
# AIVG_TTS_RATE=0

# Retry/backoff and validation-retry budget
# AIVG_GENERATION_MAX_ATTEMPTS=3
# AIVG_GENERATION_BACKOFF_BASE_SECONDS=1.0
# AIVG_GENERATION_BACKOFF_MAX_SECONDS=8.0
# AIVG_GENERATION_BACKOFF_JITTER_SECONDS=0.25
# AIVG_GENERATION_TIMEOUT_SECONDS=600
# AIVG_GENERATION_MAX_VALIDATION_ATTEMPTS=2

# Validation thresholds (defaults enforce 8-15 second scenes)
# AIVG_VALIDATION_MIN_SCENE_DURATION_SECONDS=8
# AIVG_VALIDATION_MAX_SCENE_DURATION_SECONDS=15
# AIVG_VALIDATION_REQUIRE_AUDIO=true
# AIVG_VALIDATION_MIN_WIDTH=640
# AIVG_VALIDATION_MIN_HEIGHT=360
# AIVG_VALIDATION_MIN_FPS=8

# Assembly
# AIVG_ASSEMBLY_INCLUDE_INTRO=true
# AIVG_ASSEMBLY_INCLUDE_OUTRO=true
# AIVG_ASSEMBLY_WIDTH=1280
# AIVG_ASSEMBLY_HEIGHT=720
# AIVG_ASSEMBLY_FPS=24
# AIVG_ASSEMBLY_TRANSITION=fade_black
# AIVG_ASSEMBLY_SHOW_SCENE_TITLES=true
# AIVG_ASSEMBLY_SHOW_PROGRESS=true

# Optional real AI provider credential. Only read from the environment; never
# commit it. Gemini Omni exposes no documented duration control, so validation
# measures the returned clip and may reject it for duration drift.
# GEMINI_API_KEY=
